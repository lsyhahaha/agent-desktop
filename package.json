{
  "name": "agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop coding agent",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/desktop",
    "apps/runtime",
    "packages/protocol"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w node-pty -v 45.1.0",
    "postinstall": "npm run rebuild:native",
    "evolution": "electron out/main/evolution-admin.js",
    "strategy:lab": "electron out/main/strategy-lab.js",
    "acceptance:workspace": "npm run build && node scripts/acceptance/run-workspace.cjs && node scripts/acceptance/run-workspace.cjs --production"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "pino": "10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.1.0",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@anthropic-ai/sandbox-runtime": {
      "zod": "4.6.7"
    }
  }
}
